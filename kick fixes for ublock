/// kick-tweaks.js
(function() {
    'use strict';
    if (window.ktLoaded) { return; }
    window.ktLoaded = true;
    console.info('[kick-tweaks] loaded');
    const KEY = 'kt:pauseEmotes';
    const EMOTE_URL = 'files.kick.com/emotes/';
    const EMOTE_SEL = 'img[src*="' + EMOTE_URL + '"]';
    const STILL_MAX_PX = 112;
    const stills = new Map();
    let paused = false;
    let hovered = null;
    let styled = false;
    try { paused = localStorage.getItem(KEY) === '1'; } catch (e) {}
    function isAnimated(blob) {
        return blob.slice(0, 256).arrayBuffer().then(function(buf) {
            const b = new Uint8Array(buf);
            const s = String.fromCharCode.apply(null, b);
            if (s.lastIndexOf('GIF8', 0) === 0) { return true; }
            if (s.slice(8, 16) === 'WEBPVP8X') { return (b[20] & 2) !== 0; }
            if (s.slice(1, 4) === 'PNG') { return s.indexOf('acTL') !== -1; }
            return false;
        });
    }
    function toStill(blob) {
        return createImageBitmap(blob).then(function(bmp) {
            const k = Math.min(1, STILL_MAX_PX / bmp.height);
            const c = document.createElement('canvas');
            c.width = Math.max(1, Math.round(bmp.width * k));
            c.height = Math.max(1, Math.round(bmp.height * k));
            c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
            bmp.close();
            return new Promise(function(resolve) {
                c.toBlob(function(out) {
                    resolve(out ? URL.createObjectURL(out) : null);
                }, 'image/png');
            });
        });
    }
    function getStill(src) {
        let p = stills.get(src);
        if (p) { return p; }
        p = fetch(src).then(function(r) {
            if (!r.ok) { throw new Error('http ' + r.status); }
            return r.blob();
        }).then(function(blob) {
            return isAnimated(blob).then(function(anim) {
                return anim ? toStill(blob) : null;
            });
        }).catch(function() {
            stills.delete(src);
            return null;
        });
        stills.set(src, p);
        return p;
    }
    function freeze(img) {
        if (!paused || img === hovered) { return; }
        const src = img.src;
        if (src.indexOf(EMOTE_URL) === -1) { return; }
        if (img.closest('[contenteditable="true"]')) { return; }
        getStill(src).then(function(url) {
            if (!url || !paused || img === hovered || img.src !== src) { return; }
            img.dataset.ktOrig = src;
            img.src = url;
        });
    }
    function thaw(img) {
        const orig = img.dataset.ktOrig;
        if (!orig) { return; }
        delete img.dataset.ktOrig;
        if (img.src.lastIndexOf('blob:', 0) === 0) { img.src = orig; }
    }
    function scan(root) {
        if (!root || root.nodeType !== 1) { return; }
        if (root.tagName === 'IMG') { freeze(root); return; }
        if (!root.firstElementChild) { return; }
        const imgs = root.querySelectorAll(EMOTE_SEL);
        for (let i = 0; i < imgs.length; i++) { freeze(imgs[i]); }
    }
    function apply() {
        if (paused) {
            scan(document.documentElement);
        } else {
            document.querySelectorAll('img[data-kt-orig]').forEach(thaw);
        }
        document.querySelectorAll('.kt-switch').forEach(function(sw) {
            sw.setAttribute('aria-checked', String(paused));
        });
    }
    function setPaused(value) {
        paused = value;
        try { localStorage.setItem(KEY, value ? '1' : '0'); } catch (e) {}
        apply();
    }
    document.addEventListener('mouseover', function(ev) {
        const t = ev.target;
        if (!paused || !t || t.tagName !== 'IMG' || !t.dataset.ktOrig) { return; }
        hovered = t;
        thaw(t);
    }, true);
    document.addEventListener('mouseout', function(ev) {
        if (ev.target !== hovered) { return; }
        const t = hovered;
        hovered = null;
        freeze(t);
    }, true);
    window.addEventListener('storage', function(ev) {
        if (ev.key !== KEY) { return; }
        paused = ev.newValue === '1';
        apply();
    });
    function addStyle() {
        if (styled) { return; }
        styled = true;
        const st = document.createElement('style');
        st.textContent = [
            '.kt-row{list-style:none;cursor:pointer}',
            '.kt-row-inner{display:flex;align-items:center;justify-content:space-between;gap:8px;height:100%;min-height:40px;user-select:none}',
            '.kt-switch{position:relative;flex:none;width:36px;height:20px;padding:0;border:0;border-radius:9999px;background:#474f54;cursor:pointer;transition:background-color .15s}',
            '.kt-switch>span{display:block;width:14px;height:14px;border-radius:50%;background:#fff;transform:translateX(4px);transition:transform .15s}',
            '.kt-switch[aria-checked="true"]{background:#53fc18}',
            '.kt-switch[aria-checked="true"]>span{transform:translateX(18px);background:#0b0e0f}'
        ].join('');
        (document.head || document.documentElement).appendChild(st);
    }
    function ensureRow() {
        const panel = document.getElementById('chat-settings-panel');
        if (!panel) { return; }
        const list = panel.querySelector('div.w-full > ul');
        if (!list || list.querySelector('.kt-row')) { return; }
        addStyle();
        const ref = list.lastElementChild;
        const row = document.createElement('li');
        row.className = (ref ? ref.className + ' ' : '') + 'kt-row';
        const inner = document.createElement('div');
        const refInner = ref && ref.firstElementChild;
        inner.className = (refInner && refInner.tagName === 'DIV' ? refInner.className + ' ' : '') + 'kt-row-inner';
        const label = document.createElement('span');
        label.textContent = 'Pause emote animations';
        const sw = document.createElement('button');
        sw.type = 'button';
        sw.className = 'kt-switch';
        sw.setAttribute('role', 'switch');
        sw.setAttribute('aria-label', 'Pause emote animations');
        sw.setAttribute('aria-checked', String(paused));
        sw.appendChild(document.createElement('span'));
        inner.appendChild(label);
        inner.appendChild(sw);
        row.appendChild(inner);
        row.addEventListener('click', function(ev) {
            ev.preventDefault();
            ev.stopPropagation();
            setPaused(!paused);
        });
        list.appendChild(row);
    }
    const QUALITY_KEY = 'stream_quality';
    const LOGIN_MIN_PX = 1080;
    function onQualities(list) {
        if (!Array.isArray(list) || list.length === 0) { return; }
        const guest = document.querySelector('[data-testid="login"]') !== null;
        let top = 0;
        for (let i = 0; i < list.length; i++) {
            const q = list[i];
            if (!q || !(q.height > top)) { continue; }
            if (guest && Math.min(q.width, q.height) >= LOGIN_MIN_PX) { continue; }
            top = q.height;
        }
        if (top === 0) { return; }
        sessionStorage.setItem(QUALITY_KEY, String(top));
        console.info('[kick-tweaks] stream quality set to ' + top + 'p' + (guest ? ' (logged out: 1080p+ needs a Kick login)' : ''));
    }
    function onWorkerMessage(ev) {
        const arg = ev.data && ev.data.arg;
        if (!arg || arg.key !== 'qualities') { return; }
        try { onQualities(arg.value); } catch (e) {}
    }
    if (typeof window.Worker === 'function') {
        window.Worker = new Proxy(window.Worker, {
            construct: function(target, args, newTarget) {
                const worker = Reflect.construct(target, args, newTarget);
                try { worker.addEventListener('message', onWorkerMessage); } catch (e) {}
                return worker;
            }
        });
    }
    new MutationObserver(function(muts) {
        if (paused) {
            for (let i = 0; i < muts.length; i++) {
                const m = muts[i];
                if (m.type === 'attributes') {
                    if (m.target.tagName === 'IMG') { freeze(m.target); }
                    continue;
                }
                const added = m.addedNodes;
                for (let j = 0; j < added.length; j++) { scan(added[j]); }
            }
        }
        ensureRow();
    }).observe(document, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['src']
    });
    apply();
    ensureRow();
})();
